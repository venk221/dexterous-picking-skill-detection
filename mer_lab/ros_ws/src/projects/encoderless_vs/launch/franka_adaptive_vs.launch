<launch>
    <!-- Load YAML -->
    <rosparam file="$(find encoderless_vs)/config/franka_config.yaml" command="load"/>

    <!-- Launch Realsense Camera & marker detection -->
    <include file="$(find encoderless_vs)/launch/marker_detector.launch" />
    
    <!-- Joint publisher interface -->
    <node name="franka_joint_pub" pkg="encoderless_vs" type="franka_joint_pub" output="screen" />
    
    <!-- Jacobian update -->
    <node name="franka_energy_function_node" pkg="encoderless_vs" type="franka_energy_func_node" output = "screen"/>
    
    <!-- Control node -->
    <node name="franka_adaptive_vs" pkg="encoderless_vs" type="franka_adaptive_vs_node" output="screen" respawn="false" />

    <!-- Set stiffness Service -->
    <node name="franka_stiffness_service" pkg="encoderless_vs" type="franka_joint_impedance.py" output="screen" respawn="false" />
    
    <!-- Data record -->
    <node name="franka_adaptive_vs_recorder" pkg="encoderless_vs" type="franka_data_record_node" output="screen" respawn="false" />
    
    <!-- Visualization node -->
    <node name="franka_adaptive_vs_vis" pkg="encoderless_vs" type="franka_adaptive_vs_vis_node.py" output="screen" respawn="false" required="true" />
    <node name="Image_writer" pkg="encoderless_vs" type="img_write.py" output="log" respawn="false" />
    
    <!-- PLotting node -->
    <!-- <node name="franka_adaptive_vs_plots" pkg="encoderless_vs" type="franka_plot_node.py" output="screen" respawn="false" /> -->

    <node name="franka_image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <param name="autosize" value="true" />
    	<remap from="image" to="/franka/vs/vis" />
    </node>

</launch>


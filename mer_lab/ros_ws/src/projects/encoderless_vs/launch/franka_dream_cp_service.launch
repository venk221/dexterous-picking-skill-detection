    <!client node to test the pipeline -->
    <!-- <node name="goal_control_points_gen_client" pkg="encoderless_vs" type="franka_goal_cp_svc_rqst.py" respawn="false" output="screen" required="true"/> -->

    <!-- <node name="goal_franka_goal_vis_node" pkg="encoderless_vs" type="franka_goal_img_pub.py" output="screen" /> -->
    
    <!-- Save images -->
    <!-- <node name="image_writer" pkg="encoderless_vs" type="img_write.py" output="log" respawn="false" /> --> 

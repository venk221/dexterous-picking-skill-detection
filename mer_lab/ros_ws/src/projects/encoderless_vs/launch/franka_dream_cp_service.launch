<launch>
    <arg name="i" default="/home/merlab/DREAM/trained_models/panda_dream_resnet_h.pth"/>
    <arg name="b" default="panda_link0"/>
    <arg name="initial_reset" default="true"/>

    <!-- <arg name="i" />
    <arg name="b" /> -->
     <!-- Launch camera -->
    <include file="$(find encoderless_vs)/launch/rs_encoderless.launch">
        <arg name ="initial_reset" value="$(arg initial_reset)"/>
    </include>

    <!-- <include file="$(find encoderless_vs)/launch/franka_dream_vs.launch"/> -->


        
   <!-- <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/> -->
    
    <!-- Load parameters -->
    <!-- <rosparam file="$(find encoderless_vs)/config/franka_dream_config.yaml" command="load"/> -->
    
    <!-- Launch binary image -->
    <node pkg="encoderless_vs" type="franka_dream_kp_svc.py" name="dream_kp_service" output="screen" args="--input-params-path $(arg i) --base-frame $(arg b)" />
    <!-- <node pkg="encoderless_vs" type="franka_dream_client.py" name="dream_kp_client" output="screen" />    -->

    <!-- <node name="Image_writer" pkg="encoderless_vs" type="img_write.py" output="log" respawn="false" /> -->





    <!-- skeletonize and generate control points -->

<launch>
     <!-- Launch camera -->
   <include file="$(find encoderless_vs)/launch/rs_encoderless.launch"/>
   <!-- <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/> -->
    
    <!-- Load parameters -->
    <rosparam file="$(find encoderless_vs)/config/franka_config.yaml" command="load"/>
    
    <!-- Launch binary image -->
    <node name="vis_binary_image_service" pkg="encoderless_vs" type="franka_vis_bin_svc.py" respawn="false" output="screen" />

    <!-- skeletonize and generate control points -->
    <node name="vis_control_points_gen_service" pkg="encoderless_vs" type="franka_vis_cp_svc.py" respawn="false" output="screen" />

    <!-- client node to test the pipeline -->
    <node name="vis_control_points_gen_client" pkg="encoderless_vs" type="franka_vis_cp_svc_rqst.py" respawn="false" output="screen" />

    <!-- <node name="goal_franka_goal_vis_node" pkg="encoderless_vs" type="franka_goal_img_pub.py" output="screen" /> -->
    
<!--     
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="/vsbot/goal_image" />

    </node>    -->
    

</launch>


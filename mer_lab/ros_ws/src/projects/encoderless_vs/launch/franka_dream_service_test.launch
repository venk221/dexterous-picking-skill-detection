<launch>
    <arg name="i" default="/home/merlab/DREAM/trained_models/panda_dream_resnet_h.pth"/>
    <arg name="b" default="panda_link0"/>
    <arg name="initial_reset" default="true"/>
    <!-- Load YAML -->
    <rosparam file="$(find encoderless_vs)/config/franka_dream_config.yaml" command="load"/>
    <!-- <rosparam file="$(find encoderless_vs)/config/dream_features.yaml" command="load"/> -->

    <!-- <arg name="i" />
    <arg name="b" /> -->
     <!-- Launch camera -->
    <!-- <include file="$(find encoderless_vs)/launch/rs_encoderless.launch">
        <arg name ="initial_reset" value="$(arg initial_reset)"/>
    </include> -->

    <include file="$(find encoderless_vs)/launch/rs_encoderless.launch" />

    <!-- <node name="reconfig_auto_exposure" pkg="dynamic_reconfigure" type="dynparam" args="set_from_parameters /camera/rgb_camera/auto_exposure_roi">
        <param name="min_ang" type="double" value="-1.0" />
        <param name="max_ang" type="double" value="1.0" />
    </node> -->

    <!-- <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name ="initial_reset" value="$(arg initial_reset)"/>
    </include> -->

    <!-- The next line is for the complete control pipeline. Comment the line out for testing the control/ keypoints-->
    <!-- <include file="$(find encoderless_vs)/launch/franka_dream_vs.launch"/> -->


        
   <!-- <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/> -->
    
    <!-- Load parameters -->
    <rosparam file="$(find encoderless_vs)/config/franka_dream_config.yaml" command="load"/>
    
    <!-- Launch the key point service -->
    <node pkg="encoderless_vs" type="franka_dream_img_svc.py" name="dream_kp_service" output="screen" args="--input-params-path $(arg i) --base-frame $(arg b)" />
    <node pkg="encoderless_vs" type="franka_dream_cp_svc.py" name="dream_cp_service" output="screen" />
    <!-- comment the next two lines out for complete pipeline-->>
    <node pkg="encoderless_vs" type="franka_dream_client.py" name="dream_kp_client" output="screen" />   
    <node name="franka_dream_vs_vis" pkg="encoderless_vs" type="franka_dream_vs_vis_node.py" output="screen" respawn="false" required="true" /> 

    <!-- <node name="Image_writer" pkg="encoderless_vs" type="img_write.py" output="log" respawn="false" /> -->





    <!-- skeletonize and generate control points -->
    <!-- <node name="goal_control_points_gen_service" pkg="encoderless_vs" type="franka_goal_cp_svc.py" respawn="false" output="screen" />

    <!client node to test the pipeline -->
    <!-- <node name="goal_control_points_gen_client" pkg="encoderless_vs" type="franka_goal_cp_svc_rqst.py" respawn="false" output="screen" required="true"/> -->

    <!-- <node name="goal_franka_goal_vis_node" pkg="encoderless_vs" type="franka_goal_img_pub.py" output="screen" /> -->
    
    <!-- Save images -->
    <!-- <node name="image_writer" pkg="encoderless_vs" type="img_write.py" output="log" respawn="false" /> --> 
    <!-- <node name="depth_writer" pkg="encoderless_vs" type="depth_write.py" output="screen" respawn="false" /> -->
<!--     
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="/vsbot/goal_image" />

    </node>    -->
    

</launch>


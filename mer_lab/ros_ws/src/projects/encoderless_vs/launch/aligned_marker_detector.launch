<launch>
      
    <!-- Launch camera -->
   <include file="$(find encoderless_vs)/launch/rs_encoderless.launch"/>
   <!-- <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/> -->
    
    <!-- Load parameters -->
    <rosparam file="$(find encoderless_vs)/config/franka_config.yaml" command="load"/>
    
    <!-- Launch marker detection -->
    <!-- <node name="publish_reduced_image_frequency" pkg="encoderless_vs" type="publish_reduced_color.py" respawn="false" output="screen" /> -->

    <!-- Launch skeleton node detection -->
    <node name="build_skeleton_node" pkg="encoderless_vs" type="franka_skeleton.py" respawn="false" output="screen" />
    
    <!-- Launch marker vis -->
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="log">
        <param name="autosize" value="true" />
        <!-- <param name="color_fps" value="10" /> -->
    	<remap from="image" to="marked/ros/Image"/>
    </node> 

</launch>


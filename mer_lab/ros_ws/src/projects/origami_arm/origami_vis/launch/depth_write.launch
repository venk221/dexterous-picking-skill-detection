<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find origami_control)/config/config.yaml" command="load"/>
    
    <!-- Launch the realsense aligned depth node -->
    <include file="$(find encoderless_vs)/launch/rs_encoderless.launch"/>
    

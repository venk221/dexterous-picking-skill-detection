        <node name="img_writer_node" pkg="origami_vis" type="image_write.py" output="screen" respawn="false" />


    <!-- <node name="annotated_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="" />
    </node> -->

</launch>
<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find vs_control)/config/config.yaml" command="load"/>

    <!-- Controller node -->
    <node name="origami_vs_control_node" pkg="vs_control" type="origami_control_node" output="screen" />

    <!-- Launch Realsense Camera & marker detection -->
    <include file="$(find vs_control)/launch/marker_detector.launch" />

    <!-- Jacobian service node -->

    <!-- Hardware API node -->


    <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="/vsbot/spline_img" />
    </node> -->

</launch>


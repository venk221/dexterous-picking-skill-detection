<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find vs_control)/config/config.yaml" command="load"/>
    
    <!-- Launch camera -->
    <include file="$(find vs_control)/launch/camera.launch"/>
    
    <!-- Launch marker detection -->
    <node name="marker_detect" pkg="vs_control" type="marker_detect.py" respawn="false" output="screen" />
    
    <!-- Launch marker vis -->
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<param name="autosize" value="true" />
        <remap from="image" to="origami_vs/aruco/result" />
    </node>
    

</launch>
<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find origami_control)/config/config.yaml" command="load"/>

    <!-- Controller node -->
    <node name="origami_vs_control_node" pkg="origami_control" type="origami_vs_control_node" output="screen" required="true"/>

    <!-- Launch Realsense Camera & marker detection -->
    <include file="$(find origami_vision)/launch/marker_detector.launch" />

    <!-- Jacobian service node -->
    <node name="jacobian_srv" pkg="origami_control" type="single_module_jacobian_server.py" output="screen" />
    <!-- Hardware API node -->

    <!-- Visualization -->
    <include file="$(find origami_vis)/launch/vs_vis.launch" />

    <!-- Data record -->
    <!-- <include file="$(find origami_vis)/launch/vs_recorder.launch" /> -->

    <!-- Data logger -->
    <include file="$(find origami_log)/launch/origami_vs_log.launch" />

    <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="/vsbot/spline_img" />
    </node> -->

</launch>
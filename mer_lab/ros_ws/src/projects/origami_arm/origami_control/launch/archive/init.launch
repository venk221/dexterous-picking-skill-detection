<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find origami_control)/config/config.yaml" command="load"/>

    <!-- Initialization node -->
    <node name="init_node" pkg="origami_control" type="origami_vs_init_node" output="screen" required="true"/>

    <!-- Hardware API node -->
    <node name="hardware_interface" pkg="srl_ommd" type="board_test.py" output="screen" />
    
    <!-- velocity interface -->
    <node name="vel_interface" pkg="origami_control" type="origami_velocity_interface_node" output="screen" />

    <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<remap from="image" to="/vsbot/spline_img" />
    </node> -->

</launch>


<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find origami_control)/config/config.yaml" command="load"/>
    
    <!-- Launch curve fit node -->
    <!-- <node name="curve_fit_node" pkg="origami_vision" type="curve_fit.py" output="screen" respawn="false" /> -->
    
    <!-- Clothoid fit server -->
    <node name="clothoid_fit_node" pkg="origami_vision" type="clothoid_fit_server.py" output="screen" respawn="false" />

    <!-- curve visualization -->
    <node name="curve_vis_node" pkg="origami_vis" type="curve_vis.py" output="screen" respawn="false" />
    
    <!-- Launch marker detector -->
    <include file ="$(find origami_vision)/launch/marker_detector.launch"/>

    <!-- Launch motion test -->
    <!-- <node name="motion_test" pkg="origami_control" type="origami_motion_test_node" output="screen" respawn="false" /> -->
    <!-- Launch marker vis -->
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<param name="autosize" value="true" />
        <remap from="image" to="origami_vs/curve_image" />
    </node>
    <!-- <node name="astar_class" pkg="origami_vision" type="test.py" output="screen" respawn="false" /> -->
</launch>
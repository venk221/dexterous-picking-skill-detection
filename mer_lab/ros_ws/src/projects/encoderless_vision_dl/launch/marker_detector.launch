<launch>
    <!-- Load configuration parameters -->
    <rosparam file="$(find encoderless_vision_dl)/config/config.yaml" command="load"/>
    
    <!-- Launch camera -->
    <!-- <include file="$(find origami_vision)/launch/camera.launch"/> -->
   
    <!-- Launch the realsense aligned depth node -->
    <include file="$(find encoderless_vision_dl)/launch/rs_origami.launch"/>

    <node name="set_auto_exposure_rgb" pkg="dynamic_reconfigure" type="dynparam" args="set /camera/rgb_camera enable_auto_exposure False"/>

    <!-- <node name="set_auto_exposure_depth" pkg="dynamic_reconfigure" type="dynparam" args="set /camera/stereo_module enable_auto_exposure False"/> -->
   
    <!-- Launch marker detection -->
    <node name="marker_detect" pkg="encoderless_vision_dl" type="marker_detect.py" respawn="false" output="screen" />
    <!-- <node name="test_depth_image" pkg="origami_vision" type="test_depth_image.py" respawn="false" output="screen" /> -->
    
    <!-- Launch marker vis -->
    <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<param name="autosize" value="true" />
        <remap from="image" to="origami_vs/aruco/result" />
    </node> -->
    

</launch>
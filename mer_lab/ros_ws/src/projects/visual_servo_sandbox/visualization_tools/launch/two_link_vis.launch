<launch>
    <!-- Load YAML -->
    <rosparam file="$(find controllers)/config/config.yaml" command="load"/>
    
    <!-- Launch vis node -->
    <node name="visualization_node" pkg="visualization_tools" type="robot_vis.py" output="screen" required="true" />

    <!-- Launch image view -->
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    	<param name="autosize" value="true" />
        <remap from="image" to="two_link_vs/annotated_img" />
    </node> 
</launch>
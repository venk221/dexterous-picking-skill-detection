<?xml version="1.0"?>
<robot name="mustard_bottle">
  <link name="world" />

  <link name="mustard_bottle">
    <visual>
      <geometry>
	<mesh filename="package://ycb_models/mesh/mustard_bottle/textured.dae" />
      </geometry>
    </visual>
    <collision>
      <geometry>
	<mesh filename="package://ycb_models/mesh/mustard_bottle/textured.dae" />
      </geometry>
    </collision>
    <!-- PLACEHOLDER VALUES -->
    <inertial>
      <origin xyz="-0.0150543 -0.0231094 0.0750423" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.148754e-5" ixy="0.007699e-5" ixz="-0.000505e-5"
	       iyy="0.163711e-5" iyz="0.000715e-5"
	       izz="0.042935e-5" />
    </inertial>
  </link>

  <joint name="table_mustard_bottle" type="floating">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="world" />
    <child link="mustard_bottle" />
  </joint>

  <!-- Gazebo-related details -->
  <gazebo reference="mustard_bottle">
    <dampingFactor>0.005</dampingFactor>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <mu1>10000.0</mu1>
    <mu2>10000.0</mu2>
    <minDepth>0.001</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <gazebo reference="table_mustard_bottle">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>

</robot>

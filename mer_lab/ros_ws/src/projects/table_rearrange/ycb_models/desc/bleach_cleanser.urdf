      <geometry>
	<mesh filename="package://ycb_models/mesh/bleach_cleanser/textured.dae" />
      </geometry>
    </visual>
    <collision>
      <geometry>
	<mesh filename="package://ycb_models/mesh/bleach_cleanser/textured.dae" />

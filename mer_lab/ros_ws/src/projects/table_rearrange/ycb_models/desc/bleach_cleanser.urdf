    <!-- PLACEHOLDER VALUES -->
    <inertial>
      <origin xyz="-0.0171389 0.0115744 0.099698" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="0.423421e-6" ixy="0.000343e-6" ixz="-0.024506e-6"
	       iyy="0.456609e-6" iyz="0.000213e-6"
	       izz="0.078261e-6" />

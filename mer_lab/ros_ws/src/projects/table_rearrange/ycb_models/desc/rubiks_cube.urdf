<?xml version="1.0"?>
<robot name="rubiks_cube">
  <link name="world" />

  <link name="rubiks_cube">
    <visual>
      <geometry>
	<mesh filename="package://ycb_models/mesh/rubiks_cube/textured.dae" />
      </geometry>
    </visual>
    <collision>
      <geometry>
	<mesh filename="package://ycb_models/mesh/rubiks_cube/textured.dae" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0162190 -0.0004853 0.0285899" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.009845e-5" ixy="0.000011e-5" ixz="-0.00007e-5"
	       iyy="0.009832e-05" iyz="-0.000005e-5"
	       izz="0.009826e-05" />
    </inertial>
  </link>

  <joint name="table_rubiks_cube" type="floating">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="world" />
    <child link="rubiks_cube" />
  </joint>

  <!-- Gazebo-related details -->
  <gazebo reference="rubiks_cube">
    <dampingFactor>0.005</dampingFactor>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <mu1>10000.0</mu1>
    <mu2>10000.0</mu2>
    <minDepth>0.001</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <gazebo reference="table_rubiks_cube">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>

</robot>

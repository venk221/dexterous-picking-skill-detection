<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">
  <xacro:macro name="camera_gazebo_sensor" params="xyz rpy sensor_name">

    <!-- joint/link data -->
    <!-- You can modify this to give the camera actual geometry -->
    <link name="${sensor_name}_camera_link"></link>
    <link name="${sensor_name}_optical_link"></link>
    
    <joint name="${sensor_name}_robot_camera_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="panda_link0" />
      <child link="${sensor_name}_camera_link" />
    </joint>
    <joint name="${sensor_name}_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.57 0 -1.57" />
      <parent link="${sensor_name}_camera_link" />
      <child link="${sensor_name}_optical_link" />
    </joint>


  <!-- Sensor -->
  <gazebo reference="${sensor_name}_camera_link">
      
    <sensor type="camera" name="${sensor_name}">
	  <always_on>1</always_on>
	  <visualize>true</visualize>
    <!-- make sure to match these parameters in MATLAB code etc. -->
	  <update_rate>20</update_rate>
	  <camera>
	    <horizontal_fov>1.047198</horizontal_fov>
	    <image>
	    <width>640</width>
	    <height>480</height>
	    <format>B8G8R8</format>  <!--Changed format since channels were inverted, to go back, change to R8G8B8-->
	    </image>
	    <clip>
	      <near>0.05</near>
	      <far>3</far>
	    </clip>
	  </camera>

	<plugin name="${sensor_name}_camera_plugin" filename="libgazebo_ros_camera.so">
          <!-- <baseline>0.2</baseline> -->
          <alwaysOn>true</alwaysOn>
          <!-- Keep this zero, update_rate in the parent <sensor> tag will control the frame rate. -->
          <updateRate>0.0</updateRate>
          <cameraName>${sensor_name}</cameraName>
          <imageTopicName>${sensor_name}/camera/color/image_raw</imageTopicName>
          <cameraInfoTopicName>${sensor_name}/camera/color/camera_info</cameraInfoTopicName>
          <frameName>${sensor_name}_camera_optical_link</frameName>
          <distortionK1>0</distortionK1>
          <distortionK2>0</distortionK2>
          <distortionK3>0</distortionK3>
          <distortionT1>0</distortionT1>
          <distortionT2>0</distortionT2>
          <!-- Are we supposed to set the focal length here? what is the focal length? -->
          <focalLength>0</focalLength>
          <hackBaseline>0</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>


  </xacro:macro>
</robot>
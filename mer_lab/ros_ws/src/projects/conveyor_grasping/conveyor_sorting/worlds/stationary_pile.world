<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="stationary_pile_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <physics type="ode">
      <ode>
	<solver>
	  <type>world</type>
	</solver>
	<constraints>
	  <contact_max_correcting_vel>0.0</contact_max_correcting_vel>
	  <contact_surface_layer>0.0001</contact_surface_layer>
	</constraints>
      </ode>
    </physics>
  </world>
</sdf>
